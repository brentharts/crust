fn main() {
    let a = 42; let u: u8 = 200; let q: i64 = 5;
    print(a, " ", u + a);
    let w: u8 = u + 100; print(w);
    print(1.0 / 3.0, " ", 100.0, " ", 1e20, " ", 1.5e-7, " ", 0.1 + 0.2);
    print('a', true);
    print(7 / 2, " ", -7 / 2, " ", -7 % 3, " ", 7 % -3);
    print(a as f64 / 3.0);
}
