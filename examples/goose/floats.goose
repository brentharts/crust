fn main() {
    print(1e14, " ", 123456789012345.0, " ", 999999999999999.0, " ", 1e15, " ", 1234567890123456.0, " ", 0.5e-4);
    print(match 50 { 1..50 => "in", _ => "out" }, " ", match 0 { 0..1 => "in", _ => "out" }, " ", match 1 { 0..1 => "in", _ => "out" });
    print(1.0e100, " ", 2.5e-10, " ", 3.0e5, " ", 100000.0, " ", 0.001, " ", 1e-4);
    let a: f32 = 16777216.0; print(a);
}
